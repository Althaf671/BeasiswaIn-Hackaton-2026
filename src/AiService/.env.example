# Export these variables; the service does not load .env files automatically.
# Generate a URL-safe secret of at least 32 characters, shared only with .NET.
SCHOLARBOT_SERVICE_TOKEN=<replace-with-shared-url-safe-secret>
OPENROUTER_API_KEY=<replace-with-real-openrouter-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SCHOLARBOT_MODEL=openai/gpt-6-luna
# Use a PostgreSQL role granted SELECT only; URI-encode username/password characters.
DATABASE_URL=postgresql://scholarbot_readonly:<url-encoded-password>@127.0.0.1:15432/beasiswain_dev
SCHOLARBOT_MATCHING_MODEL=gemini-3.1-flash-lite
SCHOLARBOT_MAX_ITERATIONS=6
SCHOLARBOT_MAX_TOOL_CALLS=8
SCHOLARBOT_TIMEOUT_SECONDS=90
SCHOLARBOT_MAX_OUTPUT_TOKENS=6000
SCHOLARBOT_MAX_TOTAL_TOKENS=48000
SCHOLARBOT_MAX_TOOL_RESULT_CHARACTERS=16000
