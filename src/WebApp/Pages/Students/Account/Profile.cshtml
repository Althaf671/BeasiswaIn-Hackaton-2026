@page "/akun"
@using System.Globalization
@using BeasiswaIn.Web.Pages.Students.Account
@using Microsoft.AspNetCore.Html
@using PhotographyStudio.Web.Pages.Dashboard.Shared

@model ProfileModel
@{
    var profile = Model.StudentProfileDetailInfo;
    var idCulture = CultureInfo.GetCultureInfo("id-ID");

    ViewData["Title"] = "Profil Saya";
    ViewData["Nav"] = "akun";
    var pointPercent = profile.Points > 0 ? 100 : 0;

    var descriptionLength = profile.Description?.Length ?? 0;

    @* form update profil *@
    Func<object?, IHtmlContent> updateBody = @<div class="d-flex flex-column gap-3">
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <div>
            <label asp-for="UpdateStudentProfileRequest.FullName" class="form-label required"></label>
            <input asp-for="UpdateStudentProfileRequest.FullName" class="form-control" placeholder="Masukkan nama lengkap" />
            <span asp-validation-for="UpdateStudentProfileRequest.FullName" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="UpdateStudentProfileRequest.Institution" class="form-label"></label>
            <input asp-for="UpdateStudentProfileRequest.Institution" class="form-control" placeholder="Masukkan asal instansi" />
            <span asp-validation-for="UpdateStudentProfileRequest.Institution" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="UpdateStudentProfileRequest.FinalScore" class="form-label"></label>
            <input asp-for="UpdateStudentProfileRequest.FinalScore" type="text" inputmode="decimal" class="form-control" placeholder="cth: 3,75" />
            <div class="form-text">Skala 4,00 / Rata-rata rapor</div>
            <span asp-validation-for="UpdateStudentProfileRequest.FinalScore" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="UpdateStudentProfileRequest.Description" class="form-label"></label>
            <textarea asp-for="UpdateStudentProfileRequest.Description" class="form-control" rows="5" maxlength="600" placeholder="Ceritakan minat riset, organisasi, & aspirasi studimu"></textarea>
            <div class="form-text">Maksimal 600 karakter.</div>
            <span asp-validation-for="UpdateStudentProfileRequest.Description" class="text-danger small"></span>
        </div>
    </div>;
}

<header id="header-normal" class="m-hero">
    <h1 class="text-xl font-bold tracking-tight text-white">Profil Saya</h1>
    <button id="btn-start-edit"
            type="button"
            aria-label="Edit Profil"
            class="m-hero-icon-btn"
            data-bs-toggle="offcanvas"
            data-bs-target="#updateProfileDrawer">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
</header>

<main class="m-content m-nav-space gap-4 bg-[#f7faf8] px-4 pt-4 md:px-6 lg:px-8">
    <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-4 lg:grid-cols-12 lg:items-start">

        @* kartu profil: di desktop jadi kolom kiri yang menempel (sticky) *@
        <section class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white text-center shadow-sm lg:sticky lg:top-4 lg:col-span-4">
            <div class="h-16 w-full bg-linear-to-b from-[#e3f2e9] to-[#f2f8f5]"></div>
            <div class="relative -mt-10 mx-auto h-20 w-20">
                <div class="h-20 w-20 rounded-full bg-white p-1 shadow-sm ring-2 ring-emerald-100">
                    <div id="avatar-container" class="flex h-full w-full items-center justify-center overflow-hidden rounded-full bg-emerald-50">
                        <svg id="avatar-svg" class="h-12 w-12 text-brand-700" fill="none" viewBox="0 0 64 64">
                            <polygon fill="#1A382B" points="32,8 52,18 32,28 12,18"></polygon>
                            <path d="M32 24 C44 24 50 32 50 44 C50 54 42 58 32 58 C22 58 14 54 14 44 C14 32 20 24 32 24 Z" fill="#6EE7B7"></path>
                            <circle cx="26" cy="40" fill="#FFFFFF" r="7" stroke="#047857" stroke-width="2"></circle>
                            <circle cx="38" cy="40" fill="#FFFFFF" r="7" stroke="#047857" stroke-width="2"></circle>
                            <circle cx="26" cy="40" fill="#064E3B" r="3.5"></circle>
                            <circle cx="38" cy="40" fill="#064E3B" r="3.5"></circle>
                            <polygon fill="#F59E0B" points="32,45 30,49 34,49"></polygon>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="px-4 pb-4 pt-2.5">
                <h2 id="display-name" class="text-base font-bold text-neutral-900">@profile.FullName</h2>
                <div class="mt-0.5 flex items-center justify-center gap-1 text-xs font-medium text-neutral-600">
                    <svg class="h-3.5 w-3.5 text-sky-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20M2 12h20"></path></svg>
                    <span id="display-instansi" class="font-semibold text-neutral-700">@profile.Institution</span>
                </div>
                <div class="mt-3.5 grid grid-cols-2 gap-2.5">
                    <div class="flex items-center gap-2 rounded-xl border border-brand-200/80 bg-[#eaf4ee] p-2 text-left">
                        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-brand-700 text-white shadow-sm">★</div>
                        <div class="min-w-0">
                            <div class="text-xs font-extrabold leading-tight text-neutral-900">@profile.Points <span class="text-[9px] font-bold text-neutral-600">Poin</span></div>
                            <div class="truncate text-[9px] font-semibold text-neutral-600">Kontributor Aktif</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 rounded-xl border border-amber-200/60 bg-[#FDF9ED] p-2 text-left">
                        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-amber-500 text-white shadow-sm">⚙</div>
                        <div class="min-w-0">
                            <div class="text-xs font-extrabold leading-tight text-neutral-900">Level 2</div>
                            <div class="truncate text-[9px] font-semibold text-neutral-600">Penjelajah</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @* kolom kanan di desktop: data diri + deskripsi *@
        <div class="flex flex-col gap-4 lg:col-span-8">
            <section id="section-data-diri" class="space-y-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div>
                    <h3 class="text-sm font-bold leading-snug text-neutral-900">Data Diri</h3>
                    <p class="text-[11px] font-medium text-neutral-500">Informasi akademik untuk rekomendasi beasiswa</p>
                </div>
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                    <div class="space-y-1">
                        <div class="block text-[11px] font-bold text-neutral-700">Nama Lengkap</div>
                        <div id="input-nama" class="profile-input min-h-[2.375rem] w-full break-words rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-900 shadow-sm">@profile.FullName</div>
                    </div>
                    <div class="space-y-1">
                        <div class="block text-[11px] font-bold text-neutral-700">Asal Instansi</div>
                        @if (string.IsNullOrWhiteSpace(profile.Institution))
                        {
                            <div id="input-instansi" class="profile-input min-h-[2.375rem] w-full break-words rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-gray-500 shadow-sm">Anda belum mengisi institusi</div>
                        }
                        else 
                        {
                            <div id="input-instansi" class="profile-input min-h-[2.375rem] w-full break-words rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-900 shadow-sm">@profile.Institution</div>
                        }
                    </div>
                    <div class="space-y-1 md:col-span-2">
                        <div class="block text-[11px] font-bold text-neutral-700">Indeks Prestasi Kumulatif (IPK)</div>
                        <div id="input-ipk" class="profile-input min-h-[2.375rem] w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-900 shadow-sm">@(profile.FinalScore?.ToString("N2", idCulture))</div>
                        <p class="pt-1 text-[10px] font-medium text-neutral-600">Skala 4,00 / Rata-rata rapor</p>
                    </div>
                </div>
            </section>

            <section id="section-deskripsi" class="space-y-2.5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <h3 class="text-sm font-bold leading-snug text-neutral-900">Deskripsi Diri</h3>
                        <p class="mt-0.5 text-[11px] font-medium text-neutral-500">Ceritakan minat riset, organisasi, &amp; aspirasi studimu</p>
                    </div>
                    <span id="char-counter" class="flex-shrink-0 rounded-full border border-brand-200/80 bg-[#eaf4ee] px-2.5 py-0.5 text-[10px] font-bold text-brand-700">@descriptionLength / 600</span>
                </div>
                <div id="input-deskripsi" class="profile-input block min-h-[6.5rem] w-full whitespace-pre-line break-words rounded-xl border border-slate-300 bg-white p-3 text-xs font-medium leading-relaxed text-neutral-800 shadow-sm">@profile.Description</div>
                <div class="flex items-center gap-1.5 border-t border-neutral-100 pt-2 text-[10px] font-medium text-neutral-600">
                    <span>💡</span>
                    <span>Membantu akurasi pencocokan beasiswa LPDP, BAZNAS, &amp; Swasta</span>
                </div>
            </section>
        </div>

        <section class="space-y-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:col-span-6">
            <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-neutral-900">Poin Kontributor</h3>
                <span class="rounded-md border border-amber-200/60 bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-700">Level 2</span>
            </div>
            <div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-extrabold tracking-tight text-neutral-900">@profile.Points</span>
                    <span class="text-xs font-bold text-neutral-600">/ @profile.Points.ToString("N0") Poin</span>
                </div>
                <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-emerald-100/80">
                    <div class="h-full rounded-full bg-brand-700" style="width: @(pointPercent)%"></div>
                </div>
                <p class="mt-1.5 text-[10px] font-medium text-neutral-600">@(profile.Points - profile.Points) poin lagi untuk mencapai Level 3 (Ksatria)</p>
            </div>
            <a asp-page="/Students/Leaderboard/Index" class="flex w-full items-center justify-center gap-1.5 rounded-xl border border-brand-200/80 bg-[#eaf4ee] py-2.5 text-xs font-bold text-brand-700 shadow-sm">Lihat Papan Leaderboard ➔</a>
        </section>

        <section class="space-y-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:col-span-6">
            <h3 class="text-xs font-bold text-neutral-900">Cara Mendapat Poin Kontributor</h3>
            <div class="flex items-start gap-2.5">
                <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg bg-brand-700 text-xs font-bold text-white">1</div>
                <div>
                    <h4 class="text-xs font-bold leading-tight text-neutral-900">Kirim Link Beasiswa</h4>
                    <p class="mt-0.5 text-[10px] font-medium text-neutral-600">Bagikan tautan info beasiswa resmi dari kampus/instansi.</p>
                </div>
            </div>
            <div class="flex items-start gap-2.5">
                <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg bg-brand-700 text-xs font-bold text-white">2</div>
                <div>
                    <h4 class="text-xs font-bold leading-tight text-neutral-900">Admin Verifikasi</h4>
                    <p class="mt-0.5 text-[10px] font-medium text-neutral-600">Tim memeriksa keabsahan tenggat waktu dan portal resmi.</p>
                </div>
            </div>
            <div class="flex items-start gap-2.5">
                <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg bg-brand-700 text-xs font-bold text-white">3</div>
                <div>
                    <h4 class="text-xs font-bold leading-tight text-neutral-900">+10 Poin Otomatis</h4>
                    <p class="mt-0.5 text-[10px] font-medium text-neutral-600">Poin masuk ke profil setelah disetujui tim kurasi.</p>
                </div>
            </div>
        </section>

        <form hx-boost="false" class="flex w-full items-center justify-center gap-2 rounded-2xl bg-red-600 py-3.5 text-sm font-bold text-white shadow-sm transition hover:bg-red-700 active:scale-[0.99] lg:col-span-12"" method="post" asp-page="/Identity/Logout">
            <button type="submit" class="flex" role="menuitem">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M18 12H9m9 0l-3-3m3 3l-3 3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                Keluar
            </button>
        </form>
    </div>
</main>

@await Html.PartialAsync("_BottomNav")

@* ------------------------------------------------------------------
   Layout mobile ini Tailwind dan TIDAK memuat Bootstrap, jadi class
   offcanvas/btn/form-control dari _FormDrawer tidak punya style.
   CSS di bawah hanya berlaku di dalam .offcanvas (tidak bocor ke
   halaman Tailwind). Unlayered, jadi menang atas preflight Tailwind.
------------------------------------------------------------------- *@
<style>
    .offcanvas { --bs-offcanvas-width: 400px; position: fixed; top: 0; right: 0; bottom: 0; z-index: 1045; display: flex; flex-direction: column; width: var(--bs-offcanvas-width); max-width: 100%; visibility: hidden; background: #fff; color: #212529; border-left: 1px solid rgba(0,0,0,.175); transform: translateX(100%); transition: transform .3s ease-in-out; outline: 0; font-size: 1rem; line-height: 1.5; text-align: left; }
    .offcanvas.showing, .offcanvas.show:not(.hiding) { transform: none; }
    .offcanvas.showing, .offcanvas.hiding, .offcanvas.show { visibility: visible; }
    .offcanvas-backdrop { position: fixed; inset: 0; z-index: 1040; background: #000; }
    .offcanvas-backdrop.fade { opacity: 0; }
    .offcanvas-backdrop.show { opacity: .5; }
    .offcanvas-backdrop.fade, .offcanvas.fade { transition: opacity .15s linear; }

    .offcanvas .offcanvas-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem; }
    .offcanvas .offcanvas-title { margin: 0; font-size: 1.25rem; line-height: 1.5; }
    .offcanvas .offcanvas-body { flex-grow: 1; padding: 1rem; overflow-y: auto; }

    .offcanvas .d-flex { display: flex; }
    .offcanvas .flex-column { flex-direction: column; }
    .offcanvas .flex-grow-1 { flex-grow: 1; }
    .offcanvas .overflow-hidden { overflow: hidden; }
    .offcanvas .justify-content-end { justify-content: flex-end; }
    .offcanvas .gap-2 { gap: .5rem; }
    .offcanvas .gap-3 { gap: 1rem; }
    .offcanvas .p-3 { padding: 1rem; }
    .offcanvas .px-4 { padding-left: 1.5rem; padding-right: 1.5rem; }
    .offcanvas .border-bottom { border-bottom: 1px solid #dee2e6; }
    .offcanvas .border-top { border-top: 1px solid #dee2e6; }
    .offcanvas .fw-semibold { font-weight: 600; }
    .offcanvas .small { font-size: .875em; }
    .offcanvas .text-danger { color: #dc3545; }

    .offcanvas .btn-close { box-sizing: content-box; width: 1em; height: 1em; padding: .25em; border: 0; border-radius: .375rem; opacity: .5; cursor: pointer; background: transparent url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23000'%3e%3cpath d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z'/%3e%3c/svg%3e") center / 1em auto no-repeat; }
    .offcanvas .btn-close:hover { opacity: .75; }

    .offcanvas .btn { display: inline-block; padding: .375rem .75rem; font-size: 1rem; font-weight: 400; line-height: 1.5; text-align: center; cursor: pointer; border: 1px solid transparent; border-radius: .375rem; transition: color .15s, background-color .15s, border-color .15s; }
    .offcanvas .btn:disabled { opacity: .65; pointer-events: none; }
    .offcanvas .btn-light { color: #000; background: #f8f9fa; border-color: #f8f9fa; }
    .offcanvas .btn-light:hover { background: #d3d4d5; border-color: #c6c7c8; }
    .offcanvas .btn-primary { color: #fff; background: #0d6efd; border-color: #0d6efd; }
    .offcanvas .btn-primary:hover { background: #0b5ed7; border-color: #0a58ca; }

    .offcanvas .form-label { display: inline-block; margin-bottom: .5rem; }
    .offcanvas .form-label.required::after { content: " *"; color: #dc3545; }
    .offcanvas .form-control { display: block; width: 100%; padding: .375rem .75rem; font-size: 1rem; line-height: 1.5; color: #212529; background: #fff; border: 1px solid #dee2e6; border-radius: .375rem; appearance: none; }
    .offcanvas .form-control:focus { border-color: #86b7fe; outline: 0; box-shadow: 0 0 0 .25rem rgba(13,110,253,.25); }
    .offcanvas .form-control::placeholder { color: #6c757d; opacity: 1; }
    .offcanvas textarea.form-control { min-height: calc(1.5em + .75rem + 2px); resize: vertical; }
    .offcanvas .form-text { margin-top: .25rem; font-size: .875em; color: #6c757d; }
    .offcanvas .input-validation-error { border-color: #dc3545; }
    .offcanvas .field-validation-error { display: block; }
    .offcanvas .validation-summary-errors ul { margin: 0; padding-left: 1.25rem; list-style: disc; }
</style>

@* Bootstrap JS (offcanvas). Dimuat hanya kalau belum ada, supaya tidak ganda.
   Kalau dashboard punya file lokal, ganti src dengan path yang sama. *@
<script>
    if (!window.bootstrap) {
        document.write('<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"><\/script>');
    }
</script>

@* form drawer *@
@await Html.PartialAsync(
    "~/Pages/Dashboard/Shared/_FormDrawer.cshtml",
    new FormDrawerViewModel
    {
        Id = "updateProfileDrawer",
        Title = "Edit Profil",
        Handler = "Update",
        Width = "480px",
        OpenOnLoad = !ModelState.IsValid,
        Body = updateBody
    })
