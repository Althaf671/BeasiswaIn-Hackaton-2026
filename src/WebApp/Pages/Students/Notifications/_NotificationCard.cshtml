@using BeasiswaIn.Web.Pages.Students.Notifications
@model NotificationItem
@{
    var status = Model.Status switch
    {
        NotificationStatus.Approved => "approved",
        NotificationStatus.Rejected => "rejected",
        _ => "review"
    };
}

<article data-notification data-status="@status" class="relative rounded-2xl border border-slate-200/70 bg-white p-3.5 shadow-[0_2px_6px_rgba(0,0,0,0.03)] transition-colors @(Model.Status == NotificationStatus.Rejected ? "hover:border-red-200" : "hover:border-emerald-300/60")">
    @if (!Model.IsRead)
    {
        <span data-unread-dot class="absolute top-3.5 right-3.5 h-2.5 w-2.5 rounded-full bg-[#00613a] ring-4 ring-emerald-50"></span>
    }
    <div class="flex items-start gap-3">
        @switch (Model.Status)
        {
            case NotificationStatus.Approved:
                <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[#00613a]">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path clip-rule="evenodd" fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.74-5.25z"></path></svg>
                </div>
                break;
            case NotificationStatus.Rejected:
                <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path clip-rule="evenodd" fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm-1.72 6.97a.75.75 0 10-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 101.06 1.06L12 13.06l1.72 1.72a.75.75 0 101.06-1.06L13.06 12l1.72-1.72a.75.75 0 10-1.06-1.06L12 10.94l-1.72-1.72z"></path></svg>
                </div>
                break;
            default:
                <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-amber-200/50 bg-amber-50 text-amber-600">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path clip-rule="evenodd" fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 6a.75.75 0 00-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 000-1.5h-3.75V6z"></path></svg>
                </div>
                break;
        }
        <div class="min-w-0 flex-1 pr-3">
            <h3 class="text-xs leading-snug font-bold text-slate-900">@Model.Title</h3>
            <p class="mt-1 text-[11px] leading-relaxed text-slate-600">@Model.Body</p>
            <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-1.5">
                    @switch (Model.Status)
                    {
                        case NotificationStatus.Approved:
                            <span class="rounded bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-800">+10 poin</span>
                            <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-700">Disetujui</span>
                            break;
                        case NotificationStatus.Rejected:
                            <span class="rounded bg-red-100 px-2 py-0.5 text-[11px] font-semibold text-red-700">Ditolak</span>
                            <a href="/list-beasiswa" class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-800 transition hover:bg-slate-200 active:scale-95">Kirim Ulang Link</a>
                            break;
                        default:
                            <span class="rounded border border-amber-200/60 bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800">Sedang Diperiksa</span>
                            break;
                    }
                </div>
                <span class="text-[10px] text-slate-400">@Model.Time</span>
            </div>
            @if (Model.ScholarshipName is not null)
            {
                <div class="mt-2.5 border-t border-slate-100 pt-2">
                    <a href="/detail-beasiswa?nama=@Uri.EscapeDataString(Model.ScholarshipName)" class="inline-flex items-center gap-1 text-xs font-bold text-emerald-700 transition-colors hover:text-emerald-800">
                        <span>Lihat Beasiswa</span>
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg>
                    </a>
                </div>
            }
        </div>
    </div>
</article>
