@page "/notifikasi"
@model BeasiswaIn.Web.Pages.Students.Notifications.IndexModel
@using BeasiswaIn.Web.Pages.Students.Notifications
@{
    ViewData["Title"] = "Notifikasi";
    var unread = Model.Items.Where(item => !item.IsRead).ToList();
    var read = Model.Items.Where(item => item.IsRead).ToList();
}

<header class="m-hero">
    <div class="flex w-full items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-1">
            <button id="btnBack" type="button" aria-label="Kembali" class="m-hero-icon-btn -ml-2.5">
                <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.3" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"></path></svg>
            </button>
            <h1 class="truncate text-xl font-bold tracking-tight text-white">Notifikasi</h1>
        </div>
        <button id="btnMarkAll" type="button" aria-label="Tandai semua dibaca" class="m-hero-icon-btn">
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24"><path d="M18 6 9 15l-4-4"></path><path d="m22 10-9 9-2-2"></path></svg>
        </button>
    </div>
</header>

<main class="m-content bg-[#F8FAF9] px-4 pt-4 pb-10">
    <nav id="notifTabs" class="mb-4 flex gap-1 rounded-full bg-slate-100 p-1 text-xs shadow-inner select-none" aria-label="Filter notifikasi">
        <button type="button" data-filter="all" aria-pressed="true" class="flex-1 rounded-full py-1.5 text-center transition-all">Semua (@Model.Count(null))</button>
        <button type="button" data-filter="approved" aria-pressed="false" class="flex-1 rounded-full py-1.5 text-center transition-all">Disetujui (@Model.Count(NotificationStatus.Approved))</button>
        <button type="button" data-filter="rejected" aria-pressed="false" class="flex-1 rounded-full py-1.5 text-center transition-all">Ditolak (@Model.Count(NotificationStatus.Rejected))</button>
    </nav>

    <section id="unreadSection" class="mb-5 space-y-3">
        <div class="flex items-center gap-2 px-1">
            <span class="text-[11px] font-extrabold tracking-wider text-slate-500 uppercase">Belum Dibaca</span>
            <span id="unreadCount" class="rounded-full bg-emerald-100 px-1.5 text-[10px] font-bold text-[#00613a]">@unread.Count</span>
        </div>
        <div id="unreadList" class="space-y-3">
            @foreach (var item in unread)
            {
                <partial name="_NotificationCard" model="item" />
            }
        </div>
    </section>

    <section id="readSection" class="mb-5 space-y-3">
        <div class="px-1">
            <span class="text-[11px] font-extrabold tracking-wider text-slate-500 uppercase">Sudah Dibaca</span>
        </div>
        <div id="readList" class="space-y-3">
            @foreach (var item in read)
            {
                <partial name="_NotificationCard" model="item" />
            }
        </div>
    </section>

    <p id="notifEmpty" class="hidden py-10 text-center text-xs text-slate-400">Belum ada notifikasi di kategori ini.</p>
</main>

@section Scripts {
    <script src="~/js/mobile/notifications.js" asp-append-version="true"></script>
}
