@page "/main-page"

@using BeasiswaIn.Web.Common.Helpers
@using BeasiswaIn.Web.Pages
@using BeasiswaIn.Web.Pages.Shared

@model IndexModel

@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Eksplor Beasiswa";
    ViewData["Nav"] = "eksplor";

    var now = DateTimeOffset.UtcNow;

    var sections = new[]
    {
        (Title: "Beasiswa Rekomendasi", Icon: "fa-solid fa-wand-magic-sparkles", Items: Model.RecommendedScholarship.Items),
        (Title: "Beasiswa Trending", Icon: "fa-solid fa-fire", Items: Model.TrendingScholarship.Items),
        (Title: "Beasiswa Terbaru", Icon: "fa-solid fa-bolt", Items: Model.LatestScholarship.Items)
    };
}

<header class="m-hero">
    <div class="flex w-full min-w-0 items-center justify-between gap-3">
        <div class="min-w-0">
            <h1 class="flex items-center gap-1.5 truncate text-xl font-bold tracking-tight">Hi, @Model.UserName <span aria-hidden="true">👋</span></h1>
        </div>
        <partial name="_HeroBell" />
    </div>
</header>

<main class="m-content m-nav-space gap-7 pt-6">
    @foreach (var group in sections)
    {
        <section>
            <div class="mb-3 flex items-center justify-between gap-3 px-5">
                <h2 class="m-section-title min-w-0">
                    <i class="@group.Icon text-sm text-forest-light" aria-hidden="true"></i>
                    <span class="truncate">@group.Title</span>
                </h2>
                <a href="/list-beasiswa" class="m-link shrink-0">Lihat semua</a>
            </div>
            <div class="no-scrollbar flex snap-x snap-mandatory gap-3.5 overflow-x-auto scroll-px-5 px-5 pb-2 pt-1">
                @if (group.Items.Count > 0)
                {
                    for (var i = 0; i < group.Items.Count; i++)
                    {
                        <partial 
                            name="_ExploreCard" 
                            model="ExploreCardMapper.From(group.Items[i], i, now)" />
                    }
                }
                else
                {
                    <div class="flex min-h-40 w-full shrink-0 snap-start flex-col items-center justify-center gap-2 rounded-2xl border border-dashed border-slate-300 bg-white px-4 py-6 text-center">
                        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#eaf4ee] text-brand-700" aria-hidden="true">
                            <i class="fa-regular fa-folder-open"></i>
                        </span>
                        <p class="text-xs font-semibold text-neutral-600">Belum ada daftar beasiswa untuk section ini</p>
                    </div>
                }
            </div>
        </section>
    }
</main>

@await Html.PartialAsync("_BottomNav")
