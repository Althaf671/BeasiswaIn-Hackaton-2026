@page "/main-page"
@using BeasiswaIn.Web.Pages

@model HomeModel
@{
    ViewData["Title"] = "Home page";
}

@*
    Section ini akan otomatis di render di tag head pada _Layout.cshtml
    nanti kode tailwind yang ditulis di HTML ini akan jadi class tailwind.
    PASTIKAN section ini selalu ada pada halaman yang mau menggunakan tailwind
*@
@section Styles {
    <link rel="stylesheet"
          href="~/css/tailwind/landing.css"
          asp-append-version="true" />
}

<div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
    <div class="card shadow-lg p-4 border-0 rounded-4 text-center" style="width: 100%; max-width: 600px;">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        @if (Model.IsAuthenticated)
        {
            <div class="card-body">
                <h1 class="card-title text-primary mb-3">
                    <i class="fas fa-smile-beam me-2"></i>Welcome to Our Website!
                </h1>
                <p class="card-text fs-5 text-muted">Hello <strong>@Model.Username</strong>, we're glad you're here!</p>
                <form method="post" asp-page-handler="Logout" hx-boost="false">
                    <button type="submit" class="btn btn-danger rounded-pill mt-3">
                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="card-body">
                <h3 class="text-danger"><i class="fas fa-lock me-2"></i>Access Denied</h3>
                <p class="fs-5 text-muted">You are not authenticated. Please log in to access more features.</p>
                <a asp-page="/Identity/LoginStudent" class="btn btn-primary rounded-pill">Masuk dengan Google</a>
            </div>
        }
    </div>
</div>


