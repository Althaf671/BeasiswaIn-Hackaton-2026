@page "/chat"
@model BeasiswaIn.Web.Pages.Mobile.Chat.IndexModel
@{
    ViewData["Title"] = "ScholarBot";
    ViewData["Nav"] = "chat";
}

<header class="m-hero">
    <button id="btnOpenDrawer" type="button" aria-label="Buka menu navigasi" class="m-hero-icon-btn">
        <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
</header>

<main id="chatScroll" data-empty="true" class="flex flex-1 flex-col px-4 py-6">
    <section id="chatWelcome" class="w-full rounded-2xl border border-emerald-100/90 bg-white p-5 shadow-subtle">
        <div class="mb-4 text-center">
            <h2 class="text-base font-bold text-slate-900">Mau mulai dari mana?</h2>
            <p class="mt-1.5 px-2 text-xs leading-relaxed text-slate-600">Ceritakan tujuan dan latar belakangmu sendiri. Aku bisa membantu membaca peluang, tanpa menebak profil akademikmu.</p>
        </div>
        <div class="space-y-2.5 pt-1">
            <button type="button" data-chat-prompt="Lihat preferensi dan kategori" class="flex w-full items-center justify-between rounded-2xl border border-slate-200/90 bg-white px-4 py-3 text-left text-xs font-medium text-slate-700 shadow-sm transition hover:bg-forest-soft/50 active:scale-[0.98] active:bg-[#eaf4ee]">
                <span>Lihat preferensi dan kategori</span>
                <span class="text-sm font-bold text-forest">↗</span>
            </button>
            <button type="button" data-chat-prompt="Mulai cari rekomendasi" class="flex w-full items-center justify-between rounded-2xl border border-slate-200/90 bg-white px-4 py-3 text-left text-xs font-medium text-slate-700 shadow-sm transition hover:bg-forest-soft/50 active:scale-[0.98] active:bg-[#eaf4ee]">
                <span>Mulai cari rekomendasi</span>
                <span class="text-sm font-bold text-forest">↗</span>
            </button>
        </div>
        <p class="mt-3 text-center text-[11px] text-slate-400">Siap membantu. Pilih contoh atau tulis pertanyaanmu.</p>
    </section>
</main>

<div class="m-chat-composer">
    <div class="flex items-end gap-2.5">
        <div class="flex flex-1 items-center rounded-2xl border-2 border-forest/50 bg-white px-3 py-2 shadow-sm transition focus-within:border-forest">
            <textarea id="chatInput" rows="1" class="no-scrollbar max-h-28 w-full resize-none border-0 p-0 text-[13px] leading-relaxed text-slate-800 outline-none placeholder:truncate placeholder:text-slate-400" placeholder="Tanya syarat, esai, atau tips LPDP..."></textarea>
        </div>
        <button id="chatSend" type="button" aria-label="Kirim pesan" class="mb-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-forest text-white shadow-sm transition hover:bg-forest-dark active:scale-90">
            <svg class="h-4 w-4 -translate-y-0.5 translate-x-px rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
        </button>
    </div>
</div>

@await Html.PartialAsync("_BottomNav")

<div id="chatDrawer" class="pointer-events-none top-0 bottom-0 z-50 m-fixed-column">
    <div id="drawerBackdrop" class="absolute inset-0 bg-slate-900/40 opacity-0 backdrop-blur-sm transition-opacity duration-300"></div>
    <div id="drawerPanel" class="absolute top-0 bottom-0 left-0 z-10 flex w-[82%] max-w-[320px] -translate-x-full flex-col bg-white shadow-2xl transition-transform duration-300 ease-out">
        <div class="flex items-center justify-between border-b border-emerald-100/80 bg-[#fbfdfc] p-4">
            <div class="flex items-center gap-2.5">
                <div class="flex h-8 w-8 items-center justify-center rounded-xl border border-forest-border/80 bg-[#eaf4ee] text-sm font-bold text-forest shadow-sm">S</div>
                <div>
                    <h3 class="text-xs leading-none font-bold text-slate-800">ScholarBot</h3>
                    <p class="mt-0.5 text-[10px] text-slate-500">Menu &amp; Riwayat Chat</p>
                </div>
            </div>
            <button id="btnCloseDrawer" type="button" aria-label="Tutup menu" class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-3.5">
            <button id="btnNewChat" type="button" class="flex w-full items-center justify-center gap-2 rounded-xl bg-forest px-3 py-2.5 text-xs font-semibold text-white shadow-sm transition hover:bg-forest-dark active:scale-95">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                <span>Percakapan Baru</span>
            </button>
        </div>
        <div id="historyList" class="no-scrollbar flex-1 space-y-4 overflow-y-auto px-3 pb-4">
            @foreach (var group in Model.History)
            {
                <div class="space-y-1.5" data-history-block>
                    <p class="px-2 text-[10px] font-bold tracking-wider text-slate-400 uppercase">@group.Label</p>
                    <div class="space-y-1.5" data-history-group="@group.Label">
                        @foreach (var title in group.Titles)
                        {
                            <button type="button" data-history-title="@title" class="group flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left text-xs text-slate-700 transition hover:bg-forest-soft hover:text-forest">
                                <svg class="h-3.5 w-3.5 shrink-0 text-slate-400 group-hover:text-forest" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                                <span class="truncate font-medium">@title</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="flex items-center justify-between border-t border-slate-100 bg-[#fbfdfc] p-3 text-[11px] text-slate-500">
            <div class="flex items-center gap-1.5">
                <svg class="h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                <span id="historyCount">@Model.HistoryCount riwayat tersimpan</span>
            </div>
            <button id="btnClearHistory" type="button" class="text-[11px] font-medium text-slate-400 transition hover:text-slate-600">Bersihkan</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/mobile/chat.js" asp-append-version="true"></script>
}
