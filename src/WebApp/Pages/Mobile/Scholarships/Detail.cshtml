@page "/detail-beasiswa"
@model BeasiswaIn.Web.Pages.Mobile.Scholarships.DetailModel
@{
    ViewData["Title"] = "Detail Beasiswa";
}

<div class="relative h-[300px] w-full overflow-hidden bg-gradient-to-br from-[#063d28] via-[#0b6b45] to-[#d7efe3]">
    <img alt="" class="h-full w-full object-cover opacity-0" src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1200&q=80" onload="this.classList.remove('opacity-0')" onerror="this.remove()" />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/30"></div>
    <div class="absolute top-4 left-4 z-20">
        <button id="btnBack" type="button" aria-label="Kembali" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/80 text-neutral-800 shadow-md backdrop-blur-md transition hover:bg-white active:scale-95">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </button>
    </div>
    <div class="absolute top-4 right-4 z-20">
        <button id="btnShare" type="button" aria-label="Bagikan" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/80 text-neutral-800 shadow-md backdrop-blur-md transition hover:bg-white active:scale-95">
            <span class="material-symbols-outlined text-[18px]">share</span>
        </button>
    </div>
</div>

<main id="detailMain" class="relative z-10 -mt-8 flex-1 rounded-t-[32px] bg-white">
    <div class="w-full overflow-hidden rounded-t-[32px] border-x border-t border-[#E2E8D8] bg-white">
        <div class="space-y-2 p-5 pb-4">
            <div class="mb-1 flex items-center gap-2">
                <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-800">@Model.Funding</span>
                <span class="rounded-full border border-neutral-200 bg-neutral-100 px-2.5 py-0.5 text-[11px] font-medium text-neutral-600">@Model.Level</span>
            </div>
            <h1 class="text-[18px] leading-snug font-extrabold tracking-tight text-neutral-900">@Model.Name</h1>
            <div class="flex items-center gap-1.5 pt-1 text-xs text-neutral-600">
                <span class="material-symbols-outlined text-[18px] text-[#00613a]">verified</span>
                <span class="font-medium text-neutral-700">@Model.Provider</span>
            </div>
        </div>
        <div class="mx-5 border-t border-neutral-100"></div>
        <div class="space-y-2.5 p-5 pt-4 pb-4">
            <h2 class="text-[15px] font-bold tracking-tight text-neutral-900">Deskripsi Program</h2>
            <p class="text-justify text-xs leading-relaxed text-neutral-600">Penyedia beasiswa komprehensif bagi mahasiswa aktif jenjang Sarjana (S1) di perguruan tinggi negeri maupun swasta terakreditasi minimum B di Indonesia. Mencakup tanggungan 100% biaya UKT kuliah hingga 4 semester, uang saku bulanan Rp 2.500.000, pendampingan mentoring kepemimpinan berkala dari pakar profesional, serta perlindungan asuransi kesehatan aktif.</p>
            <div class="expandable-grid" id="deskripsi-expanded">
                <div class="expandable-inner">
                    <p class="mt-1 border-t border-dashed border-emerald-100 pt-2 text-justify text-xs leading-relaxed text-neutral-600">Penerima manfaat juga berkesempatan mengikuti program pertukaran pemuda kepemimpinan tingkat nasional, akses jejaring alumni beasiswa lintas industri, serta dukungan dana inovasi tugas akhir atau riset skripsi berbasis aplikatif untuk memajukan pembangunan nasional Indonesia.</p>
                </div>
            </div>
            <div class="flex justify-center pt-1">
                <button type="button" data-accordion="deskripsi-expanded" class="inline-flex cursor-pointer items-center gap-1 rounded-full px-3 py-1 text-xs font-bold text-[#00613a] transition-colors duration-200 hover:bg-emerald-50/70 hover:text-[#004d2e] active:scale-95">
                    <span data-accordion-label class="transition-all duration-200">Read more</span>
                    <span class="material-symbols-outlined text-[15px] transition-transform duration-300">expand_more</span>
                </button>
            </div>
        </div>
        <div class="mx-5 border-t border-neutral-100"></div>
        <div class="space-y-3.5 p-5 pt-4 pb-5">
            <div>
                <div class="mb-1.5 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-[#00613a]">checklist_rtl</span>
                    <h2 class="text-[15px] font-bold tracking-tight text-neutral-900">Persyaratan Seleksi</h2>
                </div>
                <p class="text-[11px] leading-relaxed text-neutral-500">Hasil pencocokan otomatis berdasarkan data profil dan dokumen terverifikasi di akun Anda:</p>
            </div>
            <div class="space-y-2.5 pt-0.5">
                <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3">
                    <h3 class="text-xs font-bold text-neutral-900">Kewarganegaraan</h3>
                    <p class="text-[11px] text-neutral-500">Syarat: WNI dengan KTP aktif</p>
                    <p class="text-[11px] font-medium text-neutral-600">Profil Anda: NIK Terverifikasi Dukcapil</p>
                </div>
                <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3">
                    <h3 class="text-xs font-bold text-neutral-900">Status Pendidikan</h3>
                    <p class="text-[11px] text-neutral-500">Syarat: Mahasiswa S1 semester 1 - 4</p>
                    <p class="text-[11px] font-medium text-neutral-600">Profil Anda: S1 Informatika, Semester 3</p>
                </div>
                <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3">
                    <h3 class="text-xs font-bold text-neutral-900">Indeks Prestasi (IPK)</h3>
                    <p class="text-[11px] text-neutral-500">Syarat: Minimal 3,50 skala 4,00</p>
                    <p class="text-[11px] font-medium text-neutral-600">Profil Anda: IPK 3,72 (Transkrip resmi)</p>
                </div>
                <div class="expandable-grid" id="persyaratan-expanded">
                    <div class="expandable-inner space-y-2.5 pt-2.5">
                        <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3">
                            <h3 class="text-xs font-bold text-neutral-900">Akreditasi Program Studi</h3>
                            <p class="text-[11px] text-neutral-500">Syarat: Minimal B / Baik Sekali</p>
                            <p class="text-[11px] font-medium text-neutral-600">Profil Anda: Akreditasi Unggul (A) BAN-PT</p>
                        </div>
                        <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3">
                            <h3 class="text-xs font-bold text-neutral-900">Prestasi Akademik / Non</h3>
                            <p class="text-[11px] text-neutral-500">Syarat: Min. 1 sertifikat regional/nasional</p>
                            <p class="text-[11px] font-medium text-neutral-600">Profil Anda: Juara 2 Gemastik Nasional</p>
                        </div>
                        <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3">
                            <h3 class="text-xs font-bold text-neutral-900">Surat Rekomendasi</h3>
                            <p class="text-[11px] text-neutral-500">Syarat: 1 surat Dosen Pembimbing/Dekan</p>
                            <p class="text-[11px] font-medium text-neutral-600">Profil Anda: 1 Rekomendasi Tervalidasi</p>
                        </div>
                        <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3">
                            <h3 class="text-xs font-bold text-neutral-900">Sertifikat Bahasa Inggris</h3>
                            <p class="text-[11px] text-neutral-500">Syarat: TOEFL ITP ≥ 500 / IELTS 6.0</p>
                            <p class="text-[11px] font-medium text-neutral-600">Profil Anda: TOEFL ITP 485</p>
                        </div>
                        <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/20 p-3">
                            <h3 class="text-xs font-bold text-neutral-900">Esai Kontribusi (1.000 kata)</h3>
                            <p class="text-[11px] text-neutral-500">Syarat: Format PDF sesuai panduan resmi</p>
                            <p class="text-[11px] font-medium text-neutral-600">Profil Anda: Draf tersimpan (800 kata)</p>
                        </div>
                    </div>
                </div>
                <div class="flex justify-center pt-1 text-center">
                    <button type="button" data-accordion="persyaratan-expanded" class="inline-flex cursor-pointer items-center gap-1 rounded-full px-3 py-1 text-xs font-bold text-[#00613a] transition-colors duration-200 hover:bg-emerald-50/70 hover:text-[#004d2e] active:scale-95">
                        <span data-accordion-label class="transition-all duration-200">Read more</span>
                        <span class="material-symbols-outlined text-[15px] transition-transform duration-300">expand_more</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="mx-5 border-t border-neutral-100"></div>
        <div class="space-y-3 p-5 pt-4">
            <div class="flex items-center justify-between">
                <h3 class="text-[14px] font-bold text-neutral-900">Tahapan Seleksi 2026</h3>
                <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800">4 Tahap</span>
            </div>
            <div class="space-y-2 pt-1">
                <div class="flex items-center justify-between rounded-xl border border-emerald-300 bg-emerald-50/40 p-2.5 text-xs">
                    <div class="flex items-center gap-2.5">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#00613a] text-[10px] font-bold text-white">1</span>
                        <span class="font-bold text-neutral-900">Registrasi &amp; Upload Berkas</span>
                    </div>
                    <span class="rounded-md border border-emerald-200 bg-white px-2 py-0.5 text-[10px] font-semibold text-[#00613a]">Sedang Buka</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-neutral-200 bg-white p-2.5 text-xs">
                    <div class="flex items-center gap-2.5">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-neutral-100 text-[10px] font-bold text-neutral-600">2</span>
                        <span class="font-medium text-neutral-700">Seleksi Administrasi &amp; Esai</span>
                    </div>
                    <span class="text-[10px] text-neutral-400">Mendatang</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-neutral-200 bg-white p-2.5 text-xs">
                    <div class="flex items-center gap-2.5">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-neutral-100 text-[10px] font-bold text-neutral-600">3</span>
                        <span class="font-medium text-neutral-700">Wawancara Daring &amp; Uji Gagasan</span>
                    </div>
                    <span class="text-[10px] text-neutral-400">Mendatang</span>
                </div>
                <div class="flex items-center justify-between rounded-xl border border-neutral-200 bg-white p-2.5 text-xs">
                    <div class="flex items-center gap-2.5">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-neutral-100 text-[10px] font-bold text-neutral-600">4</span>
                        <span class="font-medium text-neutral-700">Pengumuman Penerima</span>
                    </div>
                    <span class="text-[10px] text-neutral-400">Mendatang</span>
                </div>
            </div>
        </div>
        <div class="mx-5 border-t border-neutral-100"></div>
        <div class="space-y-3 p-5 pt-4">
            <div class="flex items-center justify-between rounded-xl border border-[#E2E8D8] bg-[#F8FAF6] p-3">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-[22px] text-[#00613a]">description</span>
                    <div>
                        <p class="text-xs font-bold text-neutral-800">Booklet Resmi Program</p>
                        <p class="text-[10px] text-neutral-500">PDF • 4.2 MB • Panduan Lengkap</p>
                    </div>
                </div>
                <a class="rounded-lg border border-[#E2E8D8] bg-white px-3 py-1 text-xs font-semibold text-[#00613a] shadow-sm transition hover:bg-neutral-50" href="https://beasiswa.nusantara.go.id/register" target="_blank" rel="noopener noreferrer">Unduh</a>
            </div>
            <div class="grid grid-cols-2 gap-2 pt-1">
                <a class="flex items-center gap-2 rounded-xl border border-neutral-200 bg-white p-2.5 text-xs hover:bg-neutral-50" href="https://wa.me/6281123456789" rel="noopener noreferrer" target="_blank">
                    <span class="material-symbols-outlined text-[18px] text-[#00613a]">chat</span>
                    <div class="flex min-w-0 items-center gap-1.5 overflow-hidden">
                        <p class="text-[10px] text-neutral-400">WhatsApp</p>
                        <p class="truncate font-bold text-neutral-800">Helpdesk</p>
                    </div>
                </a>
                <a class="flex items-center gap-2 rounded-xl border border-neutral-200 bg-white p-2.5 text-xs hover:bg-neutral-50" href="mailto:beasiswa@nusantara.id">
                    <span class="material-symbols-outlined text-[18px] text-blue-700">mail</span>
                    <div class="flex min-w-0 items-center gap-1.5 overflow-hidden">
                        <p class="text-[10px] text-neutral-400">Email</p>
                        <p class="truncate font-bold text-neutral-800">Bantuan</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</main>

<div class="m-detail-bar">
    <div class="leading-tight">
        <span class="block text-[10px] font-bold tracking-wider text-neutral-400 uppercase">Batas Akhir:</span>
        <span class="text-xs font-extrabold text-neutral-900">@Model.Deadline</span>
        @if (!string.IsNullOrWhiteSpace(Model.DaysLeft))
        {
            <span class="block text-[10px] font-semibold text-rose-600">(@Model.DaysLeft)</span>
        }
    </div>
    <a class="flex max-w-[220px] flex-1 items-center justify-center gap-1.5 rounded-xl bg-[#00613a] px-4 py-3 text-center text-xs font-bold text-white shadow-md shadow-emerald-900/20 transition hover:bg-[#004d2e] active:scale-[0.98]" href="https://beasiswa.nusantara.go.id/register" rel="noopener noreferrer" target="_blank">
        <span>Ajukan di Portal Resmi</span>
        <span class="material-symbols-outlined text-[16px]">open_in_new</span>
    </a>
</div>

@section Scripts {
    <script src="~/js/mobile/scholarship-detail.js" asp-append-version="true"></script>
}
