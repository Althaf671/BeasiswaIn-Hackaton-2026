@page "/akun"
@model BeasiswaIn.Web.Pages.Mobile.Account.ProfileModel
@{
    ViewData["Title"] = "Profil Saya";
    ViewData["Nav"] = "akun";
    var pointPercent = (int)Math.Round(Model.Points * 100d / Model.PointGoal);
}

<header id="header-normal" class="m-hero">
    <h1 class="text-xl font-bold tracking-tight text-white">Profil Saya</h1>
    <button id="btn-start-edit" type="button" aria-label="Edit Profil" class="m-hero-icon-btn">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
</header>

<header id="header-edit" class="m-hero hidden">
    <div class="flex min-w-0 items-center gap-2">
        <button id="btn-cancel-edit" type="button" aria-label="Batal Edit" class="m-hero-icon-btn">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <h1 class="truncate text-xl font-bold tracking-tight text-white">Edit Profil</h1>
    </div>
    <button id="btn-confirm-trigger" type="button" aria-label="Terapkan Perubahan" class="m-hero-icon-btn">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"></polyline></svg>
    </button>
</header>

<main class="m-content m-nav-space gap-4 bg-[#f7faf8] px-4 pt-4">
    <section class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white text-center shadow-sm">
        <div class="h-16 w-full bg-linear-to-b from-[#e3f2e9] to-[#f2f8f5]"></div>
        <div class="relative -mt-10 mx-auto h-20 w-20">
            <div class="h-20 w-20 rounded-full bg-white p-1 shadow-sm ring-2 ring-emerald-100">
                <div id="avatar-container" class="flex h-full w-full items-center justify-center overflow-hidden rounded-full bg-emerald-50">
                    <svg id="avatar-svg" class="h-12 w-12 text-brand-700" fill="none" viewBox="0 0 64 64">
                        <polygon fill="#1A382B" points="32,8 52,18 32,28 12,18"></polygon>
                        <path d="M32 24 C44 24 50 32 50 44 C50 54 42 58 32 58 C22 58 14 54 14 44 C14 32 20 24 32 24 Z" fill="#6EE7B7"></path>
                        <circle cx="26" cy="40" fill="#FFFFFF" r="7" stroke="#047857" stroke-width="2"></circle>
                        <circle cx="38" cy="40" fill="#FFFFFF" r="7" stroke="#047857" stroke-width="2"></circle>
                        <circle cx="26" cy="40" fill="#064E3B" r="3.5"></circle>
                        <circle cx="38" cy="40" fill="#064E3B" r="3.5"></circle>
                        <polygon fill="#F59E0B" points="32,45 30,49 34,49"></polygon>
                    </svg>
                    <img id="avatar-img-preview" alt="Foto Profil Baru" class="hidden h-full w-full object-cover" />
                </div>
            </div>
        </div>
        <div class="px-4 pb-4 pt-2.5">
            <h2 id="display-name" class="text-base font-bold text-neutral-900">@Model.FullName</h2>
            <div class="mt-0.5 flex items-center justify-center gap-1 text-xs font-medium text-neutral-600">
                <svg class="h-3.5 w-3.5 text-sky-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20M2 12h20"></path></svg>
                <span id="display-instansi" class="font-semibold text-neutral-700">@Model.Institution</span>
            </div>
            <div class="mt-3.5 grid grid-cols-2 gap-2.5">
                <div class="flex items-center gap-2 rounded-xl border border-brand-200/80 bg-[#eaf4ee] p-2 text-left">
                    <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-brand-700 text-white shadow-sm">★</div>
                    <div class="min-w-0">
                        <div class="text-xs font-extrabold leading-tight text-neutral-900">@Model.Points <span class="text-[9px] font-bold text-neutral-600">Poin</span></div>
                        <div class="truncate text-[9px] font-semibold text-neutral-600">Kontributor Aktif</div>
                    </div>
                </div>
                <div class="flex items-center gap-2 rounded-xl border border-amber-200/60 bg-[#FDF9ED] p-2 text-left">
                    <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-amber-500 text-white shadow-sm">⚙</div>
                    <div class="min-w-0">
                        <div class="text-xs font-extrabold leading-tight text-neutral-900">Level 2</div>
                        <div class="truncate text-[9px] font-semibold text-neutral-600">Penjelajah</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="section-data-diri" class="space-y-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div>
            <h3 class="text-sm font-bold leading-snug text-neutral-900">Data Diri</h3>
            <p class="text-[11px] font-medium text-neutral-500">Informasi akademik untuk rekomendasi beasiswa</p>
        </div>
        <div class="space-y-1">
            <label class="block text-[11px] font-bold text-neutral-700" for="input-nama">Nama Lengkap</label>
            <input id="input-nama" class="profile-input w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-900 shadow-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600" type="text" value="@Model.FullName" />
        </div>
        <div class="space-y-1">
            <label class="block text-[11px] font-bold text-neutral-700" for="input-instansi">Asal Instansi</label>
            <input id="input-instansi" class="profile-input w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-900 shadow-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600" type="text" value="@Model.Institution" />
        </div>
        <div class="space-y-1">
            <label class="block text-[11px] font-bold text-neutral-700" for="input-ipk">Indeks Prestasi Kumulatif (IPK)</label>
            <input id="input-ipk" class="profile-input w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-900 shadow-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600" type="text" value="@Model.Gpa" />
            <p class="pt-1 text-[10px] font-medium text-neutral-600">Skala 4,00 / Rata-rata rapor</p>
        </div>
    </section>

    <section id="section-deskripsi" class="space-y-2.5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-start justify-between gap-2">
            <div>
                <h3 class="text-sm font-bold leading-snug text-neutral-900">Deskripsi Diri</h3>
                <p class="mt-0.5 text-[11px] font-medium text-neutral-500">Ceritakan minat riset, organisasi, &amp; aspirasi studimu</p>
            </div>
            <span id="char-counter" class="flex-shrink-0 rounded-full border border-brand-200/80 bg-[#eaf4ee] px-2.5 py-0.5 text-[10px] font-bold text-brand-700">0 / 500</span>
        </div>
        <textarea id="input-deskripsi" maxlength="500" rows="4" class="profile-input block w-full resize-none rounded-xl border border-slate-300 bg-white p-3 text-xs font-medium leading-relaxed text-neutral-800 shadow-sm focus:border-brand-600 focus:ring-1 focus:ring-brand-600">@Model.Bio</textarea>
        <div class="flex items-center gap-1.5 border-t border-neutral-100 pt-2 text-[10px] font-medium text-neutral-600">
            <span>💡</span>
            <span>Membantu akurasi pencocokan beasiswa LPDP, BAZNAS, &amp; Swasta</span>
        </div>
    </section>

    <section class="space-y-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-neutral-900">Poin Kontributor</h3>
            <span class="rounded-md border border-amber-200/60 bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-700">Level 2</span>
        </div>
        <div>
            <div class="flex items-baseline gap-1">
                <span class="text-xl font-extrabold tracking-tight text-neutral-900">@Model.Points</span>
                <span class="text-xs font-bold text-neutral-600">/ @Model.PointGoal.ToString("N0") Poin</span>
            </div>
            <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-emerald-100/80">
                <div class="h-full rounded-full bg-brand-700" style="width: @(pointPercent)%"></div>
            </div>
            <p class="mt-1.5 text-[10px] font-medium text-neutral-600">@(Model.PointGoal - Model.Points) poin lagi untuk mencapai Level 3 (Ksatria)</p>
        </div>
        <a asp-page="/Mobile/Leaderboard/Index" class="flex w-full items-center justify-center gap-1.5 rounded-xl border border-brand-200/80 bg-[#eaf4ee] py-2.5 text-xs font-bold text-brand-700 shadow-sm">Lihat Papan Leaderboard ➔</a>
    </section>

    <section class="space-y-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <h3 class="text-xs font-bold text-neutral-900">Cara Mendapat Poin Kontributor</h3>
        <div class="flex items-start gap-2.5">
            <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg bg-brand-700 text-xs font-bold text-white">1</div>
            <div>
                <h4 class="text-xs font-bold leading-tight text-neutral-900">Kirim Link Beasiswa</h4>
                <p class="mt-0.5 text-[10px] font-medium text-neutral-600">Bagikan tautan info beasiswa resmi dari kampus/instansi.</p>
            </div>
        </div>
        <div class="flex items-start gap-2.5">
            <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg bg-brand-700 text-xs font-bold text-white">2</div>
            <div>
                <h4 class="text-xs font-bold leading-tight text-neutral-900">Admin Verifikasi</h4>
                <p class="mt-0.5 text-[10px] font-medium text-neutral-600">Tim memeriksa keabsahan tenggat waktu dan portal resmi.</p>
            </div>
        </div>
        <div class="flex items-start gap-2.5">
            <div class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg bg-brand-700 text-xs font-bold text-white">3</div>
            <div>
                <h4 class="text-xs font-bold leading-tight text-neutral-900">+100 Poin Otomatis</h4>
                <p class="mt-0.5 text-[10px] font-medium text-neutral-600">Poin masuk ke profil setelah disetujui tim kurasi.</p>
            </div>
        </div>
    </section>

    <a href="/masuk" class="flex w-full items-center justify-center gap-2 rounded-2xl bg-red-600 py-3.5 text-sm font-bold text-white shadow-sm transition hover:bg-red-700 active:scale-[0.99]">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M18 12H9m9 0l-3-3m3 3l-3 3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        Keluar
    </a>
</main>

@await Html.PartialAsync("_BottomNav")

<div id="modal-konfirmasi" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm">
    <div class="w-full max-w-sm rounded-2xl border border-neutral-100 bg-white p-5 text-center shadow-2xl">
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </div>
        <h3 class="text-sm font-extrabold leading-snug text-neutral-900">Apakah Anda yakin ingin menerapkan perubahan profil ini?</h3>
        <p class="mt-1.5 text-xs font-medium leading-relaxed text-neutral-500">Informasi profil dan data akademik Anda yang baru akan diperbarui dan disimpan.</p>
        <div class="mt-5 flex items-center gap-2.5">
            <button id="modal-btn-cancel" type="button" class="flex-1 rounded-xl border border-slate-300 px-3 py-2.5 text-xs font-bold text-neutral-700 hover:bg-neutral-50">Batal</button>
            <button id="modal-btn-apply" type="button" class="flex-1 rounded-xl bg-brand-700 px-3 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-brand-800 active:scale-95">Terapkan</button>
        </div>
    </div>
</div>

<div id="toast-notification" class="pointer-events-none fixed left-1/2 top-5 z-50 flex -translate-x-1/2 -translate-y-20 items-center gap-2 rounded-full bg-[#004E2E] px-4 py-2.5 text-xs font-semibold text-white opacity-0 shadow-lg transition-all duration-300">
    <svg class="h-4 w-4 flex-shrink-0 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
    <span id="toast-message">Perubahan profil berhasil diterapkan!</span>
</div>

@section Scripts {
    <script src="~/js/mobile/profile.js" asp-append-version="true"></script>
}
