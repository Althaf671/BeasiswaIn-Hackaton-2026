    Reusable data table.
    Model  : list apa saja (IReadOnlyList<T>) atau response paged ({ Items, Page, PageSize, TotalCount }).
    Config : opsional, lewat ViewData["DataTable"]. Id tabel opsional: ViewData["DataTableId"].

    Struktur kolom (nama properti, tipe, opsi enum) dibaca dari TIPE model lewat reflection,
    bukan dari isi data, sehingga header, filter, dan empty state tetap benar saat data kosong.

    @await Html.PartialAsync("_DataTable", Model.TableItems)

    @await Html.PartialAsync("_DataTable", Model.TableItems, new ViewDataDictionary(ViewData)
    {
        ["DataTable"] = new
        {
            detailUrl = "/dashboard/inquiries/detail?id={id}",
            searchPlaceholder = "Cari pelanggan, email, pesan...",
            emptyText = "Belum ada permintaan",
            columns = new[] { "customerName", "phoneNumber", "status", "createdAt" }
        }
    })
*@

@using System.Collections
@using System.Reflection
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.Extensions.Options

@inject IOptions<JsonOptions> JsonOptions

@model object

@functions {
    private static Type? ElementOf(Type type)
    {
        if (type.IsArray) return type.GetElementType();

        var enumerable = type.IsGenericType && type.GetGenericTypeDefinition() == typeof(IEnumerable<>)
            ? type
            : type.GetInterfaces().FirstOrDefault(i =>
                i.IsGenericType && i.GetGenericTypeDefinition() == typeof(IEnumerable<>));

        return enumerable?.GetGenericArguments()[0];
    }

    // Tipe baris: dari response paged (properti Items) atau langsung dari list
    private static Type? RowTypeOf(Type modelType)
    {
        if (typeof(IEnumerable).IsAssignableFrom(modelType) && modelType != typeof(string))
            return ElementOf(modelType);

        var items = modelType.GetProperty("Items");
        return items is null ? null : ElementOf(items.PropertyType);
    }

    private static string KindOf(Type type)
    {
        type = Nullable.GetUnderlyingType(type) ?? type;

        if (type.IsEnum) return "enum";
        if (type == typeof(bool)) return "boolean";
        if (type == typeof(string) || type == typeof(char) || type == typeof(Guid)) return "text";
        if (type == typeof(DateTime) || type == typeof(DateTimeOffset) || type == typeof(DateOnly)) return "date";

        if (type.IsPrimitive || type == typeof(decimal)) return "number";

        if (typeof(IEnumerable).IsAssignableFrom(type)) return "list";
        return "object";
    }

    // nilai enum persis seperti yang akan muncul di JSON (ikut converter yang terdaftar)
    private static string EnumValue(Type enumType, object value, JsonSerializerOptions options)
    {
        var json = JsonSerializer.Serialize(value, enumType, options);
        return json.Trim('"');
    }

    private static List<object> BuildSchema(Type? rowType, JsonSerializerOptions options)
    {
        var schema = new List<object>();
        if (rowType is null) return schema;

        foreach (var prop in rowType.GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (prop.GetIndexParameters().Length > 0) continue;
            if (prop.GetCustomAttribute<JsonIgnoreAttribute>() is { Condition: JsonIgnoreCondition.Always }) continue;

            var name = prop.GetCustomAttribute<JsonPropertyNameAttribute>()?.Name
                ?? options.PropertyNamingPolicy?.ConvertName(prop.Name)
                ?? prop.Name;

            var kind = KindOf(prop.PropertyType);

            var options_ = new List<object>();
            if (kind == "enum")
            {
                var enumType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
                foreach (var value in Enum.GetValues(enumType))
                {
                    options_.Add(new
                    {
                        value = EnumValue(enumType, value, options),
                        label = value.ToString()
                    });
                }
            }

            schema.Add(new { key = name, type = kind, options = options_ });
        }

        return schema;
    }

    private static string ToJson(object value, JsonSerializerOptions options) =>
        JsonSerializer.Serialize(value, value.GetType(), options).Replace("</", "<\\/");
}

@{
    var jsonOptions = JsonOptions.Value.JsonSerializerOptions;

    object payload = Model ?? Array.Empty<object>();
    var dataJson = ToJson(payload, jsonOptions);

    var config = ViewData["DataTable"];
    var configJson = config is null ? "{}" : ToJson(config, jsonOptions);

    var schemaJson = ToJson(BuildSchema(RowTypeOf(payload.GetType()), jsonOptions), jsonOptions);

    var tableId = ViewData["DataTableId"] as string
        ?? $"dt-{Guid.NewGuid().ToString("N")[..8]}";
}

@if (Context.Items["__DataTableAssets"] is null)
{
    Context.Items["__DataTableAssets"] = true;

    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.3/css/dataTables.dataTables.min.css">
    <script src="https://cdn.datatables.net/3.1.3/js/dataTables.min.js"></script>
    <script src="~/js/data-table.js" asp-append-version="true"></script>
}

<div class="data-table" id="@tableId-root" data-dt-root>
    <table id="@tableId"></table>

    <script type="application/json" data-dt-data>@Html.Raw(dataJson)</script>
    <script type="application/json" data-dt-config>@Html.Raw(configJson)</script>
    <script type="application/json" data-dt-schema>@Html.Raw(schemaJson)</script>
</div>