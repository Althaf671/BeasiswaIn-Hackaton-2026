                            ["displayOrder"] = 120,
                            ["slug"] = 200,
                            ["createdAt"] = 130
                        },
                        actionsWidth = 320,

                        actions = new object[]
                        {
                            new { name = "detail", label = "Detail", icon = "eye", href = "/dashboard/gallery/portfolios/{id}" },
                        },

                        toolbar = new[]
                        {
                            new { name = "export-csv", label = "Ekspor", icon = "download",   variant = "secondary" },
                        }
                    }
                })
            </div> *@

    </div>

    @* modal delete *@
    <div class="modal fade"
        id="deleteScholarshipModal"
        tabindex="-1"
        aria-labelledby="deleteScholarshipModalLabel"
        aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title fw-semibold" id="deleteScholarshipModalLabel">
                        Hapus Lomba?
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Tutup">
                    </button>
                </div>

                <div class="modal-body">
                    Lomba <strong>@scholarship.Name</strong> akan dihapus.
                    Tindakan ini mungkin tidak dapat dibatalkan.
                    Apakah anda yakin ingin melanjutkan?
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Batal
                    </button>

                    <form id="deleteScholarshipForm"
                        method="post"
                        hx-boost="false"
                        asp-page-handler="Delete"
                        asp-route-id="@scholarship.Id">
