@{
    var nav = ViewData["Nav"] as string ?? "";
    var items = new[]
    {
        (Key: "eksplor", Page: "/Index", Label: "Eksplor",
            Icon: "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z\"></path><path d=\"M2 12h20\"></path>"),
        (Key: "beasiswa", Page: "/Mobile/Scholarships/Index", Label: "Beasiswa",
            Icon: "<path d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4\"></path>"),
        (Key: "chat", Page: "/Mobile/Chat/Index", Label: "Chatbot",
            Icon: "<path d=\"M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z\"></path>"),
        (Key: "peringkat", Page: "/Mobile/Leaderboard/Index", Label: "Peringkat",
            Icon: "<path d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"></path>"),
        (Key: "akun", Page: "/Mobile/Account/Profile", Label: "Akun",
            Icon: "<path d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\"></path>")
    };
}

<nav class="m-bottom-nav" aria-label="Navigasi utama">
    @foreach (var item in items)
    {
        <a class="m-nav-item" asp-page="@item.Page" aria-current="@(nav == item.Key ? "page" : null)">
            <span class="m-nav-icon">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">@Html.Raw(item.Icon)</svg>
            </span>
            <span>@item.Label</span>
        </a>
    }
</nav>
