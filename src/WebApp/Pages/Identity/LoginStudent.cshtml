
@page "/identity/login-student"
@using BeasiswaIn.Web.Pages.Identity
@model LoginStudentModel

@{
    ViewData["Title"] = "Login Siswa";
}

@section Head {
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fcf9f2" />
}

<main class="scholar-login scholar-login--student">
    <div class="scholar-login__card">
        <div class="scholar-login__inner">
            <partial name="_LoginBrand" />

            <section aria-labelledby="login-title">
                <h1 id="login-title" class="scholar-login__title">
                    Login
                </h1>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="scholar-login__notice" role="alert">
                        @Model.ErrorMessage
                    </div>
                }

                <form id="loginWithGoogle"
                      asp-page-handler="Login"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post"
                      hx-boost="false">

                    <button type="submit" class="scholar-login__social">
                        <svg viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#4285F4"
                                  d="M43.6 24.5c0-1.4-.1-2.8-.4-4.2H24v7.9h11a9.4 9.4 0 0 1-4.1 6.2v5h6.6c3.9-3.6 6.1-8.8 6.1-14.9Z" />
                            <path fill="#34A853"
                                  d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.6-5c-1.8 1.2-4.1 2-6.9 2-5.3 0-9.8-3.6-11.4-8.4H5.8v5.2A20.4 20.4 0 0 0 24 44Z" />
                            <path fill="#FBBC05"
                                  d="M12.6 27.7a12.2 12.2 0 0 1 0-7.4v-5.2H5.8a20 20 0 0 0 0 17.8l6.8-5.2Z" />
                            <path fill="#EA4335"
                                  d="M24 11.9c3 0 5.6 1 7.7 3l5.7-5.6A19.3 19.3 0 0 0 24 4 20.4 20.4 0 0 0 5.8 15.1l6.8 5.2A12 12 0 0 1 24 11.9Z" />
                        </svg>

                        Login dengan Google
                    </button>
                </form>

                <p class="scholar-login__back">
                    Your Scholarship Journey Starts Here
                </p>
            </section>
        </div>
    </div>
</main>
