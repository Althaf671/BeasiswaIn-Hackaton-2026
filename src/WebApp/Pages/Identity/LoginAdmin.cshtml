
@page "/identity/login"
@using BeasiswaIn.Web.Pages.Identity
@model LoginAdminModel

@{
    ViewData["Title"] = "Login Admin";
}

@section Head {
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fcf9f2" />
}

<main class="scholar-login">
    <div class="scholar-login__card">
        <div class="scholar-login__inner">
            <partial name="_LoginBrand" />

            <section aria-labelledby="login-title">
                <h1 id="login-title" class="scholar-login__title">
                    Login
                </h1>

                <form method="post"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      hx-boost="false">

                    <div asp-validation-summary="ModelOnly"
                         class="scholar-login__notice"
                         role="alert"></div>

                    <div class="scholar-login__field">
                        <div class="scholar-login__label-row">
                            <label asp-for="Input.Email">Email</label>
                        </div>

                        <div class="scholar-login__input-wrap">
                            <svg class="scholar-login__icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <circle cx="12" cy="12" r="4" />
                                <path d="M16 8v6a2 2 0 0 0 4 0v-2a8 8 0 1 0-3 6.2" />
                            </svg>

                            <input asp-for="Input.Email"
                                   type="email"
                                   class="scholar-login__input"
                                   placeholder="scholar@university.edu"
                                   autocomplete="username"
                                   aria-describedby="email-error"
                                   required />
                        </div>

                        <span asp-validation-for="Input.Email"
                              id="email-error"
                              class="scholar-login__error"></span>
                    </div>

                    <div class="scholar-login__field">
                        <div class="scholar-login__label-row">
                            <label asp-for="Input.Password">Password</label>

                            <a href="/identity/forgot-password"
                               class="scholar-login__forgot">
                                Lupa password?
                            </a>
                        </div>

                        <div class="scholar-login__input-wrap">
                            <svg class="scholar-login__icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <rect x="5" y="10" width="14" height="11" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" />
                            </svg>

                            <input asp-for="Input.Password"
                                   type="password"
                                   class="scholar-login__input"
                                   placeholder="••••••••••••"
                                   autocomplete="current-password"
                                   aria-describedby="password-error"
                                   required />

                            <button type="button"
                                    class="scholar-login__toggle"
                                    data-password-toggle
                                    aria-label="Tampilkan password"
                                    aria-pressed="false"
                                    aria-controls="Input_Password">

                                <svg class="scholar-login__icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>

                        <span asp-validation-for="Input.Password"
                              id="password-error"
                              class="scholar-login__error"></span>
                    </div>

                    <button type="submit"
                            class="scholar-login__submit">
                        Login

                        <svg class="scholar-login__icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M4 12h16m-7-7 7 7-7 7" />
                        </svg>
                    </button>
                </form>

                <p class="scholar-login__back">
                    Kembali ke
                    <a asp-page="/Index">halaman utama</a>
                </p>
            </section>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
