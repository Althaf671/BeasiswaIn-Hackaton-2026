@page "/identity/login"
@using BeasiswaIn.Web.Pages.Identity

@model LoginModel

@{
    ViewData["Title"] = "Masuk";

    ViewData["HideNavbar"] = true;
    ViewData["HideFooter"] = true;

    const string description =
        "Masuk ke akun BeasiswaIn Admin untuk mengelola akun dan mengakses layanan yang tersedia.";
}

@section Head {
    <meta name="description" content="@description" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#f3eee5" />
    <meta name="color-scheme" content="light" />
}

<div class="auth-background auth-login">
    <main class="auth-login__container">
        <section class="auth-login__card" aria-labelledby="judul-masuk">

            <a href="/"
               class="auth-login__brand"
               aria-label="Dashboard Admin — Beranda">
                BeasiswaIn Admin<span>.</span>
            </a>

            <header class="auth-login__header">
                <h1 id="judul-masuk"  style="font-size: var(--font-size-display);">Masuk ke Dashboard</h1>
                <p>Masukkan kredential akun Anda untuk melanjutkan.</p>
            </header>

            <form method="post"
                  hx-boost="false"
                  asp-page-handler="Login"
                  autocomplete="on"
                  aria-labelledby="judul-masuk"
                  class="auth-login__form">

                <div asp-validation-summary="ModelOnly"
                     class="auth-login__validation"
                     role="alert"></div>

                @* Email *@
                <div class="auth-field">
                    <label asp-for="Input.Email" class="auth-field__label">Alamat email</label>

                    <input asp-for="Input.Email"
                           type="email"
                           placeholder="admin@email.com"
                           autocomplete="username"
                           class="auth-field__input"
                           aria-required="true"
                           aria-describedby="emailHelpBlock" 
                           required />

                    <span asp-validation-for="Input.Email" class="auth-field__error"></span>
                </div>

                @* Password *@
                <div class="auth-field">
                    <label asp-for="Input.Password" class="auth-field__label">Kata sandi</label>

                    <input asp-for="Input.Password"
                           type="password"
                           placeholder="Masukkan kata sandi"
                           autocomplete="current-password"
                           class="auth-field__input"
                           aria-required="true"
                           aria-describedby="passwordHelpBlock" 
                           required />

                    <span asp-validation-for="Input.Password" class="auth-field__error"></span>
                </div>

                <a href="/identity/forgot-password" class="auth-login__forgot">
                    Lupa kata sandi?
                </a>

                <button type="submit" class="auth-login__submit">
                    <span>Masuk</span>
                </button>

            </form>

            <p class="auth-login__back">
                Kembali ke <a href="/">halaman utama</a>
            </p>
        </section>
    </main>
</div>

@section Scripts {}