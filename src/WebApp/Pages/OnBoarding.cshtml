@page "/onboarding"
@using System.Text.Json
@using BeasiswaIn.Web.Pages

@model OnBoardingModel
@{
    ViewData["Title"] = "Onboarding";
    var categoryOptionsJson = JsonSerializer.Serialize(
        Model.ScholarshipCategoryOptions,
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<svg xmlns="http://www.w3.org/2000/svg" class="d-none" aria-hidden="true">
    <symbol id="ob-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" /></symbol>
    <symbol id="ob-sparkles" viewBox="0 0 24 24"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3ZM20 2v4m-2-2h4M4 18v4m-2-2h4" /></symbol>
    <symbol id="ob-tag" viewBox="0 0 24 24"><path d="m20 13-7 7a2 2 0 0 1-3 0l-8-8V3h9l9 8a2 2 0 0 1 0 2Z" /><circle cx="7" cy="7" r="1" /></symbol>
    <symbol id="ob-essay" viewBox="0 0 24 24"><path d="M4 5h12M4 9h9M4 13h5m3 4 7-7 3 3-7 7-4 1Z" /></symbol>
    <symbol id="ob-bulb" viewBox="0 0 24 24"><path d="M9 18h6m-5 3h4M8 14a6 6 0 1 1 8 0l-1 2H9Zm4-13v1M2 8H1m22 0h-1M4 2l1 1m15-1-1 1" /></symbol>
    <symbol id="ob-upload" viewBox="0 0 24 24"><path d="M7 18H6a5 5 0 0 1-1-10 7 7 0 0 1 13-1 5.5 5.5 0 0 1 0 11h-1M12 20V10m-4 4 4-4 4 4" /></symbol>
    <symbol id="ob-trash" viewBox="0 0 24 24"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7" /></symbol>
    <symbol id="ob-cloud" viewBox="0 0 24 24"><path d="M7 18H6a5 5 0 0 1-1-10 7 7 0 0 1 13-1 5.5 5.5 0 0 1 0 11H7Zm1-6 3 3 5-5" /></symbol>
</svg>

<div class="onboarding" data-ob-shell>
    <header class="onboarding-header" data-ob-profile-header>
        <div class="onboarding-header-inner d-flex align-items-center gap-3">
            <a href="/" class="btn onboarding-back p-2" data-ob-header-back aria-label="Kembali ke beranda">
                <svg class="ob-icon" aria-hidden="true"><use href="#ob-arrow" /></svg>
            </a>
            <span class="fs-4 fw-bold" data-ob-page-title>Profil Beasiswa</span>
        </div>
    </header>

    <div class="container onboarding-content">
        <div data-ob-profile-progress class="mb-4 mb-md-5">
            <div class="d-flex justify-content-between align-items-center mb-2 small">
                <span class="onboarding-step-label fw-bold" data-ob-step-label>LANGKAH 1 DARI 2</span>
                <span class="text-body-secondary" data-ob-step-name>Esai Diri</span>
            </div>
            <div class="progress onboarding-progress" role="progressbar" aria-label="Progres pengisian profil" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar rounded-pill" data-ob-progress-bar></div>
            </div>
        </div>

        <div data-ob-result-header hidden>
            <header class="text-center mb-4">
                <h1 class="h3 fw-bold mb-1">Temukan Beasiswa yang Cocok</h1>
                <p class="text-muted mb-0">Ceritakan dirimu, pilih kategori, dan unggah sertifikat. AI akan merekomendasikan beasiswa terbaik untukmu.</p>
            </header>
            <div class="d-flex justify-content-center gap-2 mb-4">
                <span class="badge rounded-pill px-3 py-2 text-bg-light">1. Profil</span>
                <span class="badge rounded-pill px-3 py-2 text-bg-light">2. Sertifikat</span>
                <span class="badge rounded-pill px-3 py-2 text-bg-primary">3. Hasil</span>
            </div>
        </div>

        <form id="onboardingForm" method="post" asp-page-handler="Analyze" enctype="multipart/form-data" novalidate>
            <section data-ob-step="1" aria-labelledby="obProfileTitle">
                <h1 id="obProfileTitle" tabindex="-1" class="onboarding-title fw-bold mb-2">Jelaskan Tentang Dirimu</h1>
                <p class="onboarding-description mb-3">Ceritakan aspirasi, latar belakang, dan motivasimu secara singkat agar kami dapat menemukan beasiswa yang paling tepat.</p>

                <div class="card onboarding-essay mb-4">
                    <div class="card-body p-3 p-md-4">
                        <div>
                            <label asp-for="CreateStudentProfileRequest.FinalScore" class="form-label required"></label>
                            <div class="input-group">
                                <input asp-for="CreateStudentProfileRequest.FinalScore" placeholder="Masukan nama beasiswa" class="form-control" />
                            </div>
                            <span asp-validation-for="CreateStudentProfileRequest.FinalScore" class="text-danger small"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-3 border-bottom pb-3">
                            <label for="Essay" class="d-flex align-items-center gap-2 fw-semibold mb-0">
                                <svg class="ob-icon" aria-hidden="true"><use href="#ob-essay" /></svg> Esai Singkat
                            </label>
                            <span id="essayHelp" class="text-body-secondary text-nowrap"><span data-ob-essay-count>0</span> / 500</span>
                        </div>
                        <textarea id="Essay" name="Essay" rows="7" maxlength="500" class="form-control onboarding-essay-input px-0 py-4"
                                  placeholder="Contoh: Saya mahasiswa baru, memiliki pengalaman organisasi..."
                                  aria-describedby="essayHelp essayTip essayError"></textarea>
                        <div id="essayTip" class="d-flex align-items-center gap-2 border-top pt-3 text-body-secondary small">
                            <svg class="ob-icon flex-shrink-0" aria-hidden="true"><use href="#ob-bulb" /></svg>
                            <span>Tips: Ceritakan minat spesifik dan kontribusi yang ingin kamu berikan.</span>
                        </div>
                    </div>
                </div>
                <div id="essayError" class="text-danger small mb-3" data-ob-error="Essay" role="alert"></div>

                <div data-ob-chips data-options="@categoryOptionsJson" data-placeholder="Ketik untuk mencari kategori" class="mb-4">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                        <label class="form-label d-flex align-items-center gap-2 fw-semibold mb-0" for="obChipInput">
                            <svg class="ob-icon" aria-hidden="true"><use href="#ob-tag" /></svg> Kategori Beasiswa
                        </label>
                        <span class="badge rounded-pill onboarding-count"><span data-ob-category-count>0</span> Terpilih</span>
                    </div>
                    <div data-ob-chips-box class="list-chip-box form-control onboarding-chips"></div>
                    <div class="text-danger small mt-2" data-ob-error="CategoryIds" role="alert"></div>
                </div>
                <button type="button" class="btn btn-primary onboarding-continue rounded-pill w-100 d-flex align-items-center justify-content-center gap-2" data-ob-next>
                    Simpan dan Lanjut <svg class="ob-icon" aria-hidden="true"><use href="#ob-arrow" /></svg>
                </button>
            </section>

            <section data-ob-step="2" hidden aria-labelledby="obCertificateTitle">
                <h1 id="obCertificateTitle" tabindex="-1" class="onboarding-title fw-bold mb-2">Unggah Dokumen Sertifikat</h1>
                <p class="onboarding-description mb-4">Lampirkan bukti sertifikat prestasi, TOEFL/IELTS, atau sertifikat organisasi terbaru untuk memperkuat profil beasiswamu.</p>

                <div class="onboarding-upload card mb-4" data-ob-dropzone>
                    <input id="certificateInput" type="file" class="onboarding-file-input" accept="image/jpeg,image/png,image/webp" aria-label="Pilih gambar sertifikat" aria-describedby="certificateHelp" />
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-4">
                        <div class="onboarding-upload-icon mb-4 position-relative">
                            <svg class="ob-icon" aria-hidden="true"><use href="#ob-upload" /></svg>
                            <span class="onboarding-upload-plus rounded-circle" aria-hidden="true">+</span>
                        </div>
                        <span class="fs-5 fw-bold mb-1">Pilih dokumen atau seret ke sini</span>
                        <span id="certificateHelp" class="text-body-secondary">Format didukung: JPG, PNG, WebP<br />(Maks. @(OnBoardingModel.MaxFileSizeBytes / 1024 / 1024) MB per berkas)</span>
                    </div>
                </div>
                <div class="text-danger small mb-3" data-ob-error="Certificates" role="alert"></div>
                <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h6 fw-semibold mb-0">File Terpilih <span class="badge rounded-pill onboarding-count ms-1" data-ob-file-count>0</span></h2>
                    <span class="small text-body-secondary">Maks. 1 berkas</span>
                </div>
                <ul class="list-unstyled d-flex flex-column gap-3 mb-4" data-ob-file-list aria-live="polite"></ul>
                <div class="text-danger small mb-3" data-ob-error="general" role="alert"></div>
                <button type="submit" class="btn btn-primary onboarding-continue rounded-pill w-100 d-flex align-items-center justify-content-center gap-2" data-ob-submit>
                    Analisa dengan Personalisasi <svg class="ob-icon" aria-hidden="true"><use href="#ob-sparkles" /></svg>
                </button>
                <button type="button" class="btn btn-link onboarding-back-link d-block mx-auto mt-3" data-ob-back>Kembali ke profil</button>
            </section>

        @* ===== STEP 3 (diisi JS) ===== *@
        <section data-ob-step="3" hidden>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Rekomendasi Beasiswa</h2>
                <a href="/onboarding" class="btn btn-outline-secondary btn-sm">Mulai ulang</a>
            </div>
            <div class="d-flex flex-column gap-3" data-ob-result aria-live="polite"></div>
        </section>

        </form>
    </div>
    <footer class="onboarding-footer d-flex justify-content-center align-items-center gap-2 text-body-secondary small" data-ob-profile-footer>
        <svg class="ob-icon" aria-hidden="true"><use href="#ob-cloud" /></svg>
        <span>Lengkapi profil untuk rekomendasi yang lebih sesuai</span>
    </footer>
</div>

<div class="modal fade" id="obScholarshipModal" tabindex="-1" aria-labelledby="obScholarshipModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content rounded-4">
            <div class="modal-header align-items-start gap-3 p-4">
                <div>
                    <p class="small text-body-secondary mb-1">Detail Beasiswa</p>
                    <h2 class="modal-title h5 fw-bold" id="obScholarshipModalTitle"></h2>
                </div>
                <button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="modal" aria-label="Tutup detail"></button>
            </div>
            <div class="modal-body p-4" data-ob-modal-body></div>
            <div class="modal-footer gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <a class="btn btn-outline-primary" data-ob-modal-guide target="_blank" rel="noopener noreferrer">Lihat panduan</a>
                <a class="btn btn-primary" data-ob-modal-register target="_blank" rel="noopener noreferrer">Daftar beasiswa</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/on-boarding.js" asp-append-version="true"></script>
}
